{
  "default-configuration": "Prod",
  "configurations": [
    "Dev",
    "Prod",
  ],
  "localizations": {
    "development": "en",
    "supported": [
      "Base",
    ],
  },
  "packages": [
    {
      "kind": "remote",
      "repository": "https://github.com/Alamofire/Alamofire",
      "version": {
        "up-to-next-major-version": "5.12.0",
      },
    }, {
      "kind": "remote",
      "repository": "https://github.com/aws-amplify/amplify-swift",
      "version": {
        "up-to-next-major-version": "2.63.0",
      },
    },
  ],
  "files": [
    {
      "kind": "folder",
      "path": "friend-search",
      "target-membership": [
        "friend-search",
      ],
      "membership-exceptions": [
        {
          "target": "friend-searchTests",
          "inclusions": [
            "API/CognitoAuthAPI.swift",
            "API/DevEndpoint.swift",
            "API/Endpoint.swift",
            "API/FriendSearchAPI.swift",
            "APIModel/ErrorResponseAPIModel.swift",
            "APIModel/GameCatalogAPIModel.swift",
            "APIModel/PostRequestAPIModel.swift",
            "APIModel/PostResponseAPIModel.swift",
            "APIModel/ProfileAPIModel.swift",
            "Model/AppError.swift",
            "Model/AuthResult.swift",
            "Model/Game.swift",
            "Model/ModelConversionError.swift",
            "Model/Post.swift",
            "Model/UserProfile.swift",
            "Repository/AuthRepository.swift",
            "Repository/GameRepository.swift",
            "Repository/PostRepository.swift",
            "Repository/ProfileRepository.swift",
            "Repository/RepositoryErrors.swift",
            "UseCase/Auth/RestoreSessionUseCase.swift",
            "UseCase/Auth/SignInUseCase.swift",
            "UseCase/Auth/SignOutUseCase.swift",
            "UseCase/Game/GetGamesUseCase.swift",
            "UseCase/Post/ClosePostUseCase.swift",
            "UseCase/Post/CreatePostUseCase.swift",
            "UseCase/Post/GetPostUseCase.swift",
            "UseCase/Post/JoinPostUseCase.swift",
            "UseCase/Post/LeavePostUseCase.swift",
            "UseCase/Post/ListMyPostsUseCase.swift",
            "UseCase/Post/ListPostsUseCase.swift",
            "UseCase/Post/SearchPostsUseCase.swift",
            "UseCase/Profile/BootstrapProfileUseCase.swift",
            "UseCase/Profile/GetProfileUseCase.swift",
            "UseCase/Profile/UpdateProfileUseCase.swift",
            "ViewModel/Auth/AuthViewModels.swift",
            "ViewModel/Game/GameCatalogStore.swift",
            "ViewModel/Game/GamePickerViewModel.swift",
            "ViewModel/Game/GameSearchIndex.swift",
            "ViewModel/Post/CreatePostViewModel.swift",
            "ViewModel/Post/PostDetailViewModel.swift",
            "ViewModel/Post/PostListViewModel.swift",
            "ViewModel/Profile/ProfileViewModels.swift",
            "ViewModel/Root/RootViewModel.swift",
            "ViewModel/Shared/ErrorMessage.swift",
            "ViewModel/Shared/IdenticonPattern.swift",
            "ViewModel/Shared/InputRules.swift",
            "ViewModel/Shared/PostPager.swift",
            "ViewModel/Shared/PostPresentation.swift",
            "ViewModel/Shared/ViewState.swift",
          ],
        },
      ],
    },
    { "kind": "folder", "path": "friend-searchTests", "target-membership": [ "friend-searchTests" ] },
    { "kind": "folder", "path": "friend-searchUITests", "target-membership": [ "friend-searchUITests" ] },
    { "kind": "group", "name": "Frameworks" },
    {
      "kind": "group",
      "name": "Products",
      "children": [
        { "path": "<PRODUCTS>/friend-search.app", "id": "6AE09D1130963ACB00A416AC", "type": "wrapper.application", "index": false },
        { "path": "<PRODUCTS>/friend-searchTests.xctest", "id": "6AE09D2030963ACD00A416AC", "type": "wrapper.cfbundle", "index": false },
        { "path": "<PRODUCTS>/friend-searchUITests.xctest", "id": "6AE09D2A30963ACD00A416AC", "type": "wrapper.cfbundle", "index": false },
      ],
    },
  ],
  "targets": [
    {
      "name": "friend-search",
      "id": "6AE09D1030963ACB00A416AC",
      "product": "Products/friend-search.app",
      "product-type": "application",
      "build-phases": [
        "compile-sources",
        "frameworks",
        "resources",
      ],
      "package-product-members": [
        {
          "package": "Alamofire",
          "product-name": "Alamofire",
          "build-phase": { "build-phase": "frameworks" },
        }, {
          "package": "amplify-swift",
          "product-name": "AWSCognitoAuthPlugin",
          "build-phase": { "build-phase": "frameworks" },
        }, {
          "package": "amplify-swift",
          "product-name": "AWSPluginsCore",
